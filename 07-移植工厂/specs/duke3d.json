{
  "schema": 1,
  "id": "duke3d",
  "title": "Duke Nukem 3D (EDuke32)",
  "family": "source-port",
  "source": {
    "repo": "https://voidpoint.io/terminx/eduke32.git",
    "commit": "ec5824db81817866f70da326d3811bb0f52b3517",
    "local": "F:/_scratch/duke_src",
    "patches": [
      "patches/duke3d-no-alsa.patch"
    ]
  },
  "data": {
    "policy": "user-supplied",
    "required": [
      "DUKE3D.GRP"
    ],
    "notes": "引擎随包，DUKE3D.GRP 由玩家自备（正版光盘或 3D Realms 免费分享版），包里不放任何商业数据。"
  },
  "license": {
    "engine": "GPL-2.0-or-later",
    "build_engine": "BUILD engine license (source/build/doc/build.txt)"
  },
  "targets": {
    "handheld": {
      "profile": "zig-aarch64",
      "arch": "aarch64",
      "min_glibc": "2.29",
      "deps": [
        {
          "id": "sdl2"
        }
      ],
      "build": {
        "system": "gnumake",
        "target": "eduke32",
        "artifact": "eduke32",
        "timeout": 2400,
        "make_vars": {
          "PLATFORM": "LINUX",
          "ARCH": "aarch64",
          "BITS": "64",
          "USE_OPENGL": "0",
          "POLYMER": "0",
          "HAVE_GTK2": "0",
          "HAVE_FLAC": "0",
          "HAVE_VORBIS": "0",
          "USE_LIBVPX": "0",
          "USE_MIMALLOC": "0",
          "CUSTOMOPT": "-Wno-error=date-time -DEDUKE32_NO_ALSA -g0 -ffile-prefix-map=${src}=. -Wl,--strip-debug",
          "SUBPLATFORM": "HANDHELD"
        }
      },
      "package": {
        "platform": "portmaster",
        "port_dir": "duke3d",
        "launcher_file": "Duke3D.sh",
        "binary": "./eduke32",
        "zip_name": "Duke3D.zip",
        "files": [
          {
            "src": "${artifact}",
            "dst": "duke3d/eduke32"
          }
        ],
        "license_files": [
          "licenses/gpl-2.0.txt",
          "licenses/build.txt"
        ],
        "screenshot": "duke3d/screenshot.png",
        "data_required": [
          "DUKE3D.GRP"
        ],
        "data_message": "缺少 DUKE3D.GRP：请把你的正版或免费分享版 DUKE3D.GRP 放到 ports/duke3d/ 目录。",
        "data_message_en": "Missing DUKE3D.GRP: copy your own copy into ports/duke3d/.",
        "attr": {
          "title": "Duke Nukem 3D",
          "desc": "EDuke32（GPL-2.0 引擎）交叉编译的 aarch64 版，640x480 软件渲染，SDL2 音频。游戏数据 DUKE3D.GRP 由玩家自备，包内不含任何商业数据。",
          "inst": "Copy your own DUKE3D.GRP (retail or shareware) into ports/duke3d/ next to the engine, then launch.",
          "genres": [
            "fps"
          ],
          "porter": [
            "教程示例"
          ],
          "image": {},
          "rtr": false,
          "exp": false,
          "runtime": [],
          "min_glibc": "2.29",
          "reqs": [],
          "arch": [
            "aarch64"
          ]
        }
      },
      "gates": [
        "elf",
        "no_build_paths",
        "portmaster_layout",
        "data_policy",
        "licenses",
        "deterministic_zip",
        "screenshot"
      ]
    },
    "windows": {
      "profile": "mingw64",
      "build": {
        "system": "gnumake",
        "target": "duke3d",
        "artifact": "eduke32.exe",
        "timeout": 2400,
        "patches": [
          "patches/duke3d-mingw-ld.patch"
        ],
        "make_vars": {
          "PLATFORM": "WINDOWS",
          "SUBLATFORM": "",
          "NOASM": "1",
          "STARTUP_WINDOW": "0",
          "USE_OPENGL": "0",
          "POLYMER": "0",
          "USE_LIBVPX": "0",
          "USE_MIMALLOC": "0",
          "HAVE_FLAC": "0",
          "HAVE_VORBIS": "0",
          "HAVE_XMP": "0",
          "CUSTOMOPT": "-Wno-error=date-time -g0"
        }
      },
      "package": {
        "platform": "portmaster",
        "port_dir": "duke3d-win",
        "launcher_file": "Duke3D-win.sh",
        "binary": "./eduke32.exe",
        "zip_name": "Duke3D-win-proof.zip",
        "files": [
          {
            "src": "${artifact}",
            "dst": "duke3d-win/eduke32.exe"
          }
        ],
        "license_files": [
          "licenses/gpl-2.0.txt",
          "licenses/build.txt"
        ],
        "screenshot": "duke3d/screenshot.png",
        "data_required": [
          "DUKE3D.GRP"
        ],
        "attr": {
          "title": "Duke Nukem 3D (Windows proof build)",
          "desc": "同源 Windows 构建，只用于在电脑上验证玩法与截图，不面向掌机分发。",
          "inst": "Copy your own DUKE3D.GRP next to eduke32.exe.",
          "genres": [
            "fps"
          ],
          "porter": [
            "教程示例"
          ],
          "image": {},
          "rtr": false,
          "exp": true,
          "runtime": [],
          "min_glibc": "",
          "reqs": [],
          "arch": [
            "x86_64"
          ]
        }
      },
      "gates": [
        "portmaster_layout",
        "data_policy",
        "licenses",
        "deterministic_zip",
        "screenshot"
      ]
    }
  }
}
