bytes":1293,"dropped_lines":0,"n_chunks":2,"citation_sha256":"44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a","reused":false},"知识库P1_20261118/megaman2_candidate_20261125/evidence/mm2_tasvideos_object_table_20261125.txt":{"indexed":true,"sha256":"792c65e4d14ef07711429b09c0a6fd881caab39dbacce72c8f3fa97c2a4d882e","bytes":664,"dropped_lines":0,"n_chunks":1,"citation_sha256":"44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a","reused":false},"知识库P1_20261118/megaman2_candidate_20261125/evidence/mm2_local_memory_dictionary_20261125.txt":{"indexed":true,"sha256":"2b3397d00e1cafa421d99bc66d116b2d10159beccd0123e7084e208a46bbd539","bytes":1035,"dropped_lines":0,"n_chunks":1,"citation_sha256":"44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a","reused":false},"知识库P1_20261118/megaman2_candidate_20261125/evidence/mm2_local_title_catalog_20261125.txt":{"indexed":true,"sha256":"9365bd8c757e5907895d5ecd1aa11df6de46d929da4f6ae605448df32cc583d3","bytes":498,"dropped_lines":0,"n_chunks":1,"citation_sha256":"44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a","reused":false},"知识库P1_20261118/megaman2_candidate_20261125/evidence/mm2_local_tas_publications_20261125.txt":{"indexed":true,"sha256":"d5cfd8f5152d1bda1135e3d265c0b7e27c936f1016eddbdea9927c56298e9cbf","bytes":2981,"dropped_lines":0,"n_chunks":4,"citation_sha256":"44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a","reused":false}},"chunks":[{"chunk_id":"b6b12455181d","path":"知识库P1_20261118/megaman2_candidate_20261125/evidence/mm2_tasvideos_coordinates_20261125.txt","source_id":"tasvideos_rockman_data_mm2_extract","revision":"megaman2_nes_tasvideos_rockman2","game_id":"megaman2","platform":"NES","authority":"authoritative","citation_authority":{},"status":"verified_read","last_verified":"2026-11-25","element_types":["帧数据","基础档案"],"kind":"prose","heading":"Rockman 2 coordinate system — verbatim extract","lang":"zh","line_start":2,"line_end":22,"text":"> Origin: _工具脚本/taspipe/游戏包/来源库/取证/tasvideos_gameresources_rockman_data_2026-11-23.txt\n> Original line ranges: 122-132; 167-190\n> Qualification: Source-scoped technical evidence; no PAL/US regional equivalence is asserted.\nRockman technical data\nIntroduction\nThis is technical data that has been analyzed from the Rockman game ROM\nfor the purpose of making Rockman tool-assisted speedruns as precise as possible.\nThe disassembly of the game\nhas been an invaluable help in discovering these.\nAll numbers on this page are hexadecimal unless otherwise mentioned.\nCoordinate system\nIn Rockman and Rockman 2, every object of the game has the following properties:\nScreen number (00―FF), it tells which screen the object resides in.","text_sha":"0538e33dea886ea392fbabe08cd884424733b87a","dl":118},{"chunk_id":"f17a53db90ee","path":"知识库P1_20261118/megaman2_candidate_20261125/evidence/mm2_tasvideos_coordinates_20261125.txt","source_id":"tasvideos_rockman_data_mm2_extract","revision":"megaman2_nes_tasvideos_rockman2","game_id":"megaman2","platform":"NES","authority":"authoritative","citation_authority":{},"status":"verified_read","last_verified":"2026-11-25","element_types":["帧数据","基础档案"],"kind":"prose","heading":"Rockman 2 coordinate system — verbatim extract","lang":"zh","line_start":24,"line_end":41,"text":"X position (00.00―FF.FF), it tells where in the screen the object is in.\nY position (00.00―FF.FF), it tells where in the screen the object is in.\nX speed (−80.00―7F.FF).\nY speed (−80.00―7F.FF).\nThe position of the object has 8 bits of decimal part,\nbut only the integer part can be observed on the screen.\nY coordinates increase towards the bottom of the screen\nX coordinates increase towards the right\nNegative Y speed means falling, positive Y speed means ascending\nX speed is always positive. It is subtracted or added depending on Rockman’s facing.","text_sha":"cff50d2560076e994fff1899735992b8297c5e04","dl":96},{"chunk_id":"9ff506f3f74c","path":"知识库P1_20261118/megaman2_candidate_20261125/evidence/mm2_tasvideos_jump_20261125.txt","source_id":"tasvideos_rockman_data_mm2_extract","revision":"megaman2_nes_tasvideos_rockman2","game_id":"megaman2","platform":"NES","authority":"authoritative","citation_authority":{},"status":"verified_read","last_verified":"2026-11-25","element_types":["帧数据","基础档案"],"kind":"prose","heading":"Rockman 2 jump curve — verbatim extract","lang":"zh","line_start":2,"line_end":18,"text":"> Origin: _工具脚本/taspipe/游戏包/来源库/取证/tasvideos_gameresources_rockman_data_2026-11-23.txt\n> Original line ranges: 196-208\n> Qualification: Source-scoped technical evidence; no PAL/US regional equivalence is asserted.\nIn Rockman 1 and 2, when Rockman jumps, his Y speed is set to 04.DF.\nIn Rockman 3, when Rockman jumps, his Y speed is set to 04.A5.\nIn Rockman 4, when Rockman jumps, his Y speed is set to 04.C0.\nEvery frame, 00.40 is subtracted from his Y speed (0.25 in decimal).\nIn Rockman 1 and 2, if the Y speed grows smaller than −0C.00 (−12 in decimal), it is set to −0C.00.\nIn Rockman 3 and 4, if the Y speed grows smaller than −07.00, it is set to −07.00.\nIn Rockman 1 and 2, if the Y speed is larger than 02.1F and the player is not holding the A button, the speed is immediately set to 01.00.","text_sha":"e4e8d78a2c664337120ad029f2aefd73c1791c8b","dl":159},{"chunk_id":"5b3cef3e58f1","path":"知识库P1_20261118/megaman2_candidate_20261125/evidence/mm2_tasvideos_climb_transform_20261125.txt","source_id":"tasvideos_rockman_data_mm2_extract","revision":"megaman2_nes_tasvideos_rockman2","game_id":"megaman2","platform":"NES","authority":"authoritative","citation_authority":{},"status":"verified_read","last_verified":"2026-11-25","element_types":["帧数据","基础档案"],"kind":"prose","heading":"Rockman 2 climbing and transforming — verbatim extract","lang":"zh","line_start":2,"line_end":14,"text":"> Origin: _工具脚本/taspipe/游戏包/来源库/取证/tasvideos_gameresources_rockman_data_2026-11-23.txt\n> Original line ranges: 253-261\n> Qualification: Source-scoped technical evidence; no PAL/US regional equivalence is asserted.\nIn Rockman 1 and 2, Rockman climbs at speed of 00.C0.\nIn Rockman 3, Rockman climbs at speed of 01.4C.\nTransforming\nIn Rockman 1, Rockman’s Y speed and position are accumulated even during transforming. (Which allows him to pass through enemies without hurting himself.)\nIn Rockman 2, Y speed is reset when pausing. During transforming, enemies move. (Which allows them to pass through Rockman without hurting him.)","text_sha":"b49514dc005c4f6b726e6e1a5c5964c4a76e06e5","dl":102},{"chunk_id":"44cfa72f11e9","path":"知识库P1_20261118/megaman2_candidate_20261125/evidence/mm2_tasvideos_jump_horizontal_20261125.txt","source_id":"tasvideos_rockman_data_mm2_extract","revision":"megaman2_nes_tasvideos_rockman2","game_id":"megaman2","platform":"NES","authority":"authoritative","citation_authority":{},"status":"verified_read","last_verified":"2026-11-25","element_types":["帧数据","基础档案"],"kind":"prose","heading":"Rockman 2 horizontal motion while jumping — verbatim extract","lang":"zh","line_start":2,"line_end":14,"text":"> Origin: _工具脚本/taspipe/游戏包/来源库/取证/tasvideos_gameresources_rockman_data_2026-11-23.txt\n> Original line ranges: 271-279\n> Qualification: Source-scoped technical evidence; no PAL/US regional equivalence is asserted.\nIn Rockman 1 and 2, during jumping/falling into some direction, Rockman’s X speed is 01.50.\nIn Rockman 3 and 4, during jumping/falling, Rockman’s X speed is the same as when walking.\nIf the player stops pressing the directional button, the speed falls immediately into 00.00.\nIn Rockman 1, if Rockman starts moving after not moving, his X speed first goes to 00.20, then back to 01.50.\nIn Rockman 2, if Rockman starts moving after not moving, his X speed goes immediately back to 01.50.","text_sha":"04a7a67e9a29d91ed82d04bf2a781e30a969bd20","dl":122},{"chunk_id":"602aba16e312","path":"知识库P1_20261118/megaman2_candidate_20261125/evidence/mm2_tasvideos_walking_20261125.txt","source_id":"tasvideos_rockman_data_mm2_extract","revision":"megaman2_nes_tasvideos_rockman2","game_id":"megaman2","platform":"NES","authority":"authoritative","citation_authority":{},"status":"verified_read","last_verified":"2026-11-25","element_types":["帧数据","基础档案"],"kind":"prose","heading":"Rockman 2 walking speed — verbatim extract","lang":"zh","line_start":2,"line_end":12,"text":"> Origin: _工具脚本/taspipe/游戏包/来源库/取证/tasvideos_gameresources_rockman_data_2026-11-23.txt\n> Original line ranges: 281-287\n> Qualification: Source-scoped technical evidence; no PAL/US regional equivalence is asserted.\nWalking\nWalking speed\nIn Rockman 1 and 2, during walking, Rockman’s X speed is 01.60.\nIn Rockman 3 and 4, during walking, Rockman’s X speed is 01.4C.","text_sha":"4f444159e5fdfc3395fdd9f1a4fb33b5d63b8d61","dl":62},{"chunk_id":"3f8904d056e0","path":"知识库P1_20261118/megaman2_candidate_20261125/evidence/mm2_tasvideos_acceleration_20261125.txt","source_id":"tasvideos_rockman_data_mm2_extract","revision":"megaman2_nes_tasvideos_rockman2","game_id":"megaman2","platform":"NES","authority":"authoritative","citation_authority":{},"status":"verified_read","last_verified":"2026-11-25","element_types":["帧数据","基础档案"],"kind":"prose","heading":"Rockman 2 acceleration and deceleration — verbatim extract","lang":"zh","line_start":2,"line_end":16,"text":"> Origin: _工具脚本/taspipe/游戏包/来源库/取证/tasvideos_gameresources_rockman_data_2026-11-23.txt\n> Original line ranges: 289-305\n> Qualification: Source-scoped technical evidence; no PAL/US regional equivalence is asserted.\nSliding speed\nIn Rockman 3 and 4, during sliding, Rockman’s X speed is 02.80.\nAcceleration\nIn Rockman 1, when Rockman accelerates from non-full speed (full halt or deacceleration), his X speed is 00.20 for 9 frames before gaining full speed.\nIn Rockman 2, when Rockman accelerates from non-full speed (full halt or deacceleration, item-throwing halt excluded), his X speed is 00.20 for 7 frames before gaining full speed.\nIn Rockman 3, when Rockman accelerates from non-full speed, he walks normally the first frame (as far as speed is concerned), then is completely in stall for 8 frames, after which he has the full speed again.","text_sha":"b1877254ce26c8479f00ba78e81ed6b99ffed5f1","dl":144},{"chunk_id":"3d2c64390945","path":"知识库P1_20261118/megaman2_candidate_20261125/evidence/mm2_tasvideos_acceleration_20261125.txt","source_id":"tasvideos_rockman_data_mm2_extract","revision":"megaman2_nes_tasvideos_rockman2","game_id":"megaman2","platform":"NES","authority":"authoritative","citation_authority":{},"status":"verified_read","last_verified":"2026-11-25","element_types":["帧数据","基础档案"],"kind":"prose","heading":"Rockman 2 acceleration and deceleration — verbatim extract","lang":"zh","line_start":18,"line_end":22,"text":"Deceleration\nIn Rockman 1, when Rockman decelerates from full speed (not from acceleration), his X speed is 00.80 for 13 (decimal) frames before halting completely.\nIn Rockman 2, when Rockman decelerates from full speed (not from acceleration), his X speed is 00.80 for 8 (decimal) frames before halting completely.","text_sha":"1d494c8e0b814ca70ee49e9f724d7e6f3e951ca6","dl":49},{"chunk_id":"9af2298d3422","path":"知识库P1_20261118/megaman2_candidate_20261125/evidence/mm2_tasvideos_object_table_20261125.txt","source_id":"tasvideos_rockman_data_mm2_extract","revision":"megaman2_nes_tasvideos_rockman2","game_id":"megaman2","platform":"NES","authority":"authoritative","citation_authority":{},"status":"verified_read","last_verified":"2026-11-25","element_types":["帧数据","基础档案"],"kind":"table","heading":"","lang":"zh","line_start":1,"line_end":18,"text":"# Rockman 2 object RAM table — verbatim extract\n> Origin: _工具脚本/taspipe/游戏包/来源库/取证/tasvideos_gameresources_rockman_data_2026-11-23.txt\n> Original line ranges: 424-432; 441-443\n> Qualification: Source-scoped technical evidence; no PAL/US regional equivalence is asserted.\nMemory addresses\nRead from the disassembly .\nGame Screen# X (hi,lo) Xspd (hi,lo) Y (hi,lo) Yspd (hi,lo)\nRockman 1 $460 $480:$4A0 $4C0:$4E0 $600:$620 $660:$680\nRockman 2 $440 $460:$480 $600:$620 $4A0:$4C0 $640:$660\nThe variables for object # n can be found by adding n to each address.\nBoss has n =1 in RM1/2, Rockman always has n =0.","text_sha":"b5edc145c74c5cf165f6cf7b5e231e3f1263fcf3","dl":124},{"chunk_id":"9b219f872ec5","path":"知识库P1_20261118/megaman2_candidate_20261125/evidence/mm2_local_memory_dictionary_20261125.txt","source_id":"local_megaman2_memory_dictionary","revision":"megaman2_nes_memory_dictionary_unverified","game_id":"megaman2","platform":"NES","authority":"reference_only","citation_authority":{},"status":"verified_read","last_verified":"2026-11-25","element_types":["金手指","基础档案"],"kind":"table","heading":"","lang":"zh","line_start":1,"line_end":14,"text":"# MegaMan2_NES local memory dictionary — verbatim extract\n> Origin: _工具脚本/taspipe/游戏数据字典/expanded_50_games_memory_maps.json\n> Original line ranges: 15-23\n> Qualification: Secondary local aggregate; per-field provenance and ROM identity are not established.\n\"MegaMan2_NES\": {\n\"platform\": \"NES\",\n\"stable_retro_id\": \"MegaMan2-Nes\",\n\"domain\": \"RAM\",\n\"hp\": {\"addr\": \"0x06C0\", \"max\": 28},\n\"weapons_owned_bitmask_1\": {\"addr\": \"0x009A\", \"max\": 255, \"note\": \"AtomicFire/AirShooter/LeafShield/BubbleLead/QuickBoomerang/TimeStopper/MetalBlade/ClashBomber\"},\n\"weapons_owned_bitmask_2\": {\"addr\": \"0x009B\", \"max\": 7, \"note\": \"Item-1 / Item-2 / Item-3\"},\n\"weapon_select\": {\"addr\": \"0x00A9\", \"values\": {\"Buster\": 0, \"AtomicFire\": 1, \"AirShooter\": 2, \"LeafShield\": 3, \"BubbleLead\": 4, \"QuickBoomerang\": 5, \"TimeStopper\": 6, \"MetalBlade\": 7, \"ClashBomber\": 8, \"Item1\": 9, \"Item2\": 10, \"Item3\": 11}},\n\"energy_range\": {\"start\": \"0x009C\", \"end\": \"0x00A6\", \"max\": 28}","text_sha":"905207077c008722705f25f1eea94c5872489431","dl":118},{"chunk_id":"a7bfe6915c60","path":"知识库P1_20261118/megaman2_candidate_20261