# 取自官方 PortMaster Quake 3 端口的按键布局：左摇杆=方向键，右摇杆=鼠标，
# R1/R2=开火，L1=鼠标右键，A=跳，B=蹲，Start=Esc，Back=Tab（计分板）。
back = esc
start = enter
a = space
b = b
x = x
y = y
l1 = mouse_right
l2 = m
l3 = g
r1 = mouse_left
r2 = n
r3 = h
up = i
down = k
left = j
right = l
left_analog_up = up
left_analog_down = down
left_analog_left = left
left_analog_right = right
right_analog_up = mouse_movement_up
right_analog_down = mouse_movement_down
right_analog_left = mouse_movement_left
right_analog_right = mouse_movement_right
deadzone_triggers = 3000
mouse_scale = 4096
mouse_delay = 16
